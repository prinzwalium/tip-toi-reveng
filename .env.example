# Settings for the tttool web GUI containers.
#
#   cp .env.example .env
#
# docker compose reads .env automatically; every value below is optional and
# falls back to the default shown in the comment.

# ---------------------------------------------------------------- networking

# Host port the GUI is published on.
#TTTOOL_PORT=8080

# Address to bind to. Use 127.0.0.1 when a reverse proxy terminates TLS in
# front of the container; 0.0.0.0 exposes it on every interface.
#TTTOOL_BIND_IP=0.0.0.0

# ------------------------------------------------------------------- storage

# Where the projects end up: the name of a docker volume, or a path on the
# host such as ./data (which must be writable by uid 1000 —
# "mkdir -p data && sudo chown -R 1000:1000 data").
#TTTOOL_DATA=tttool-data

# ---------------------------------------------------------------------- auth

# HTTP basic auth. Both have to be set for it to take effect. There are no
# user accounts: whoever gets in can read and write every project. Do not put
# the GUI on a public address without this (and TLS in front of it).
#TTTOOL_WEB_USER=tiptoi
#TTTOOL_WEB_PASSWORD=change-me

# ------------------------------------------------------------------ behaviour

# Largest upload accepted, in megabytes. A reverse proxy usually has its own,
# smaller limit (nginx: client_max_body_size).
#TTTOOL_WEB_MAX_UPLOAD_MB=512

# Seconds after which a running tttool command is killed.
#TTTOOL_WEB_TIMEOUT=300

# Set to false to hide the delete buttons for files and projects.
#TTTOOL_WEB_ALLOW_DELETE=true

# Time zone used for the timestamps in the file list.
#TZ=Europe/Berlin

# --------------------------------------------------------------------- image

# docker-compose.yml only: how the image gets its tttool binary.
#   build   – compile it from this repository with GHC (~30 min, ~4 GB RAM)
#   release – download the official static x86_64 binary (~1 min)
#TTTOOL_SOURCE=build

# Image to run. docker-compose.ghcr.yml pulls this one; docker-compose.yml
# uses it as the name for the image it builds. Channels:
#   :latest  the newest release — use this unless you have a reason not to
#   :1.2.3   a fixed release (also :1.2 and :1)
#   :beta    the next version, for testing; report problems with the build id
#            shown in the page footer
#   :edge    every merge to master, rough edges included
# Switching channels does not touch your projects in /data.
#TTTOOL_IMAGE=ghcr.io/prinzwalium/tttool-web:latest

# Name of the container, in case you run more than one.
#TTTOOL_CONTAINER_NAME=tttool-web
